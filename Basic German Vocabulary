<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>DE Deutsch Wortschatz — Glossar (Tag 01–05)</title>
  <style>
    :root {
      --bg: #f1f5f9;
      --card: #ffffff;
      --text: #0f172a;
      --muted: #475569;
      --primary: #1e40af;
      --border: #e2e8f0;

      /* Article Colors */
      --der-main: #2563eb;
      --der-bg: #eff6ff;
      --der-border: #bfdbfe;

      --die-main: #e11d48;
      --die-bg: #fff1f2;
      --die-border: #fecdd3;

      --das-main: #059669;
      --das-bg: #ecfdf5;
      --das-border: #a7f3d0;

      --none-main: #64748b;
      --none-bg: #f8fafc;
      --none-border: #cbd5e1;

      --shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Noto Sans Bengali", sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.55;
      padding-bottom: 50px;
    }

    header {
      background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);
      color: #ffffff;
      padding: 26px 16px 34px;
      text-align: center;
    }

    header h1 {
      font-size: 1.7rem;
      font-weight: 800;
      letter-spacing: -0.01em;
    }

    header p {
      color: #cbd5e1;
      font-size: 0.92rem;
      margin-top: 4px;
    }

    .legend-bar {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 12px;
      font-size: 0.8rem;
    }

    .legend-pill {
      padding: 3px 10px;
      border-radius: 999px;
      font-weight: 700;
      color: #fff;
    }

    .container {
      max-width: 1140px;
      margin: -20px auto 0;
      padding: 0 16px;
    }

    .stats-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 12px;
      margin-bottom: 16px;
    }

    .stat-box {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 12px 14px;
      text-align: center;
      box-shadow: var(--shadow);
    }

    .stat-box .num {
      font-size: 1.45rem;
      font-weight: 800;
      color: var(--primary);
    }

    .stat-box .lbl {
      font-size: 0.82rem;
      color: var(--muted);
    }

    .controls-panel {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 16px;
      box-shadow: var(--shadow);
      margin-bottom: 18px;
    }

    .mode-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 14px;
    }

    .mode-btn {
      padding: 8px 16px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: #f8fafc;
      color: var(--text);
      font-weight: 700;
      font-size: 0.9rem;
      cursor: pointer;
    }

    .mode-btn.active {
      background: var(--primary);
      color: #fff;
      border-color: var(--primary);
    }

    .filter-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
      gap: 10px;
    }

    input, select {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid var(--border);
      border-radius: 10px;
      font-size: 0.93rem;
      background: #fff;
      color: var(--text);
    }

    /* Dictionary Grid */
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 16px;
    }

    .word-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-top-width: 5px;
      border-radius: 16px;
      padding: 16px;
      box-shadow: var(--shadow);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 12px;
      transition: transform 0.15s ease;
    }

    .word-card:hover {
      transform: translateY(-2px);
    }

    .theme-der { border-top-color: var(--der-main); }
    .theme-die { border-top-color: var(--die-main); }
    .theme-das { border-top-color: var(--das-main); }
    .theme-none { border-top-color: var(--none-main); }

    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
    }

    .tag-pill {
      font-size: 0.78rem;
      font-weight: 700;
      background: #f1f5f9;
      color: #334155;
      padding: 3px 10px;
      border-radius: 999px;
    }

    .art-pill {
      font-size: 0.78rem;
      font-weight: 800;
      padding: 3px 10px;
      border-radius: 999px;
      color: #fff;
    }

    .pill-der { background: var(--der-main); }
    .pill-die { background: var(--die-main); }
    .pill-das { background: var(--das-main); }
    .pill-none { background: var(--none-main); }

    .word-row {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 10px;
      margin-top: 6px;
    }

    .german-title {
      font-size: 1.38rem;
      font-weight: 800;
      line-height: 1.25;
    }

    .txt-der { color: var(--der-main); }
    .txt-die { color: var(--die-main); }
    .txt-das { color: var(--das-main); }
    .txt-none { color: var(--text); }

    .plural-line {
      font-size: 0.87rem;
      color: var(--muted);
      margin-top: 4px;
    }

    .plural-line strong {
      color: var(--text);
    }

    .audio-btn {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      border: 1px solid var(--border);
      background: #f8fafc;
      color: var(--text);
      padding: 6px 10px;
      border-radius: 10px;
      font-size: 0.82rem;
      font-weight: 700;
      cursor: pointer;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .audio-btn:hover {
      background: #e2e8f0;
    }

    .audio-btn.speaking {
      background: #dbeafe;
      border-color: var(--der-main);
      color: var(--der-main);
    }

    .meaning-block {
      border-top: 1px dashed var(--border);
      border-bottom: 1px dashed var(--border);
      padding: 10px 0;
    }

    .bn-text {
      font-size: 1.08rem;
      font-weight: 700;
      color: #0f172a;
    }

    .en-text {
      font-size: 0.9rem;
      color: var(--muted);
    }

    .example-card {
      background: #f8fafc;
      border-left: 3px solid #94a3b8;
      border-radius: 8px;
      padding: 10px 12px;
      font-size: 0.88rem;
    }

    .theme-der .example-card { background: var(--der-bg); border-left-color: var(--der-main); }
    .theme-die .example-card { background: var(--die-bg); border-left-color: var(--die-main); }
    .theme-das .example-card { background: var(--das-bg); border-left-color: var(--das-main); }

    .ex-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 8px;
    }

    .ex-de {
      font-weight: 700;
      color: #1e293b;
    }

    .ex-bn {
      color: #475569;
      margin-top: 3px;
    }

    .card-footer {
      display: flex;
      gap: 8px;
    }

    .status-btn {
      flex: 1;
      padding: 8px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: #fff;
      font-size: 0.84rem;
      font-weight: 700;
      cursor: pointer;
    }

    .status-btn.fav-on {
      background: #fef9c3;
      border-color: #eab308;
      color: #854d0e;
    }

    .status-btn.learn-on {
      background: #dcfce7;
      border-color: #16a34a;
      color: #166534;
    }

    /* Flashcard */
    .flash-container {
      max-width: 560px;
      margin: 0 auto;
      text-align: center;
    }

    .flash-card {
      background: var(--card);
      border: 2px solid var(--border);
      border-top-width: 6px;
      border-radius: 20px;
      padding: 32px 22px;
      min-height: 270px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      box-shadow: var(--shadow);
      cursor: pointer;
      margin-bottom: 14px;
    }

    .flash-word {
      font-size: 2rem;
      font-weight: 800;
      margin: 10px 0 4px;
    }

    .flash-back {
      width: 100%;
      margin-top: 14px;
      padding-top: 14px;
      border-top: 1px solid var(--border);
    }

    .nav-btns {
      display: flex;
      justify-content: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .primary-btn {
      background: var(--primary);
      color: #fff;
      border: none;
      padding: 10px 18px;
      border-radius: 10px;
      font-weight: 700;
      cursor: pointer;
    }

    /* Quiz */
    .quiz-box {
      max-width: 620px;
      margin: 0 auto;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 20px;
      box-shadow: var(--shadow);
    }

    .quiz-opts {
      display: grid;
      gap: 10px;
      margin-top: 14px;
    }

    .quiz-opt {
      text-align: left;
      padding: 12px 14px;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: #fff;
      font-size: 0.95rem;
      cursor: pointer;
    }

    .quiz-opt.correct {
      background: #dcfce7;
      border-color: #16a34a;
      font-weight: 700;
    }

    .quiz-opt.wrong {
      background: #fee2e2;
      border-color: #dc2626;
    }

    .empty-state {
      text-align: center;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 36px 16px;
      color: var(--muted);
    }
  </style>
</head>
