      { id: 88, day: "Tag 05", serial: 8, artikel: "das", german: "Arabisch", plural: "(kein Plural) meist ohne Artikel", bangla: "আরবি ভাষা", english: "Arabic (language)", exDe: "Mein Freund spricht Arabisch.", exBn: "আমার বন্ধু আরবি বলে।" },
      { id: 89, day: "Tag 05", serial: 9, artikel: "die", german: "Nationalität", plural: "die Nationalitäten", bangla: "জাতীয়তা", english: "nationality", exDe: "Was ist Ihre Nationalität?", exBn: "আপনার জাতীয়তা কী?" },
      { id: 90, day: "Tag 05", serial: 10, artikel: "die", german: "Staatsangehörigkeit", plural: "die Staatsangehörigkeiten", bangla: "নাগরিকত্ব", english: "citizenship", exDe: "Meine Staatsangehörigkeit ist bangladeschisch.", exBn: "আমার নাগরিকত্ব বাংলাদেশি।" },
      { id: 91, day: "Tag 05", serial: 11, artikel: "der", german: "Bangladescher", plural: "die Bangladescher (f.: die Bangladescherin)", bangla: "বাংলাদেশি (পুরুষ)", english: "Bangladeshi (m.)", exDe: "Ich bin Bangladescher.", exBn: "আমি একজন বাংলাদেশি।" },
      { id: 92, day: "Tag 05", serial: 12, artikel: "der", german: "Deutsche", plural: "die Deutschen (ein Deutscher / eine Deutsche)", bangla: "জার্মান নাগরিক", english: "German (person)", exDe: "Der Deutsche wohnt in Berlin.", exBn: "জার্মান ভদ্রলোক বার্লিনে থাকেন।" },
      { id: 93, day: "Tag 05", serial: 13, artikel: "der", german: "Inder", plural: "die Inder (f.: die Inderin)", bangla: "ভারতীয় (পুরুষ)", english: "Indian (m.)", exDe: "Der Inder kocht sehr gut.", exBn: "ভারতীয় ভদ্রলোক খুব ভালো রান্না করেন।" },
      { id: 94, day: "Tag 05", serial: 14, artikel: "der", german: "Franzose", plural: "die Franzosen (f.: die Französin)", bangla: "ফরাসি (পুরুষ)", english: "Frenchman", exDe: "Der Franzose spricht schnell.", exBn: "ফরাসি ভদ্রলোক দ্রুত কথা বলেন।" },
      { id: 95, day: "Tag 05", serial: 15, artikel: "der", german: "Türke", plural: "die Türken (f.: die Türkin)", bangla: "তুর্কি (পুরুষ)", english: "Turk (m.)", exDe: "Der Türke arbeitet in Köln.", exBn: "তুর্কি ভদ্রলোক কলোনে কাজ করেন।" },
      { id: 96, day: "Tag 05", serial: 16, artikel: "der", german: "Amerikaner", plural: "die Amerikaner (f.: die Amerikanerin)", bangla: "আমেরিকান (পুরুষ)", english: "American (m.)", exDe: "Der Amerikaner kommt aus Texas.", exBn: "আমেরিকান ভদ্রলোক টেক্সাস থেকে এসেছেন।" },
      { id: 97, day: "Tag 05", serial: 17, artikel: "der", german: "Chinese", plural: "die Chinesen (f.: die Chinesin)", bangla: "চীনা (পুরুষ)", english: "Chinese (m.)", exDe: "Der Chinese lernt Deutsch.", exBn: "চীনা ভদ্রলোক জার্মান শিখছেন।" },
      { id: 98, day: "Tag 05", serial: 18, artikel: "der", german: "Pakistaner", plural: "die Pakistaner (f.: die Pakistanerin)", bangla: "পাকিস্তানি (পুরুষ)", english: "Pakistani (m.)", exDe: "Der Pakistaner ist mein Nachbar.", exBn: "পাকিস্তানি ভদ্রলোক আমার প্রতিবেশী।" },
      { id: 99, day: "Tag 05", serial: 19, artikel: "der", german: "Brite", plural: "die Briten (f.: die Britin)", bangla: "ব্রিটিশ (পুরুষ)", english: "Briton (m.)", exDe: "Der Brite trinkt gern Tee.", exBn: "ব্রিটিশ ভদ্রলোক চা পান করতে ভালোবাসেন।" },
      { id: 100, day: "Tag 05", serial: 20, artikel: "der", german: "Ausländer", plural: "die Ausländer (f.: die Ausländerin)", bangla: "বিদেশি (পুরুষ)", english: "foreigner", exDe: "Viele Ausländer leben in Deutschland.", exBn: "অনেক বিদেশি জার্মানিতে বাস করেন।" }
    ];
    // =========================================================================
    // VOCABULARY DATA END
    // =========================================================================

    const STORAGE_KEY = "deutsch_glossar_progress_v1";
    let state = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{"fav":[],"learned":[]}');
    let activeMode = "dictionary";
    let flashIdx = 0;
    let flashShowBack = false;
    let quizData = null;
    let quizLocked = false;
    let quizChosen = null;

    function persist() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    }

    // German Text-to-Speech Audio Function
    function speakGerman(text, btnEl) {
      if (!("speechSynthesis" in window)) {
        alert("দুঃখিত, আপনার ব্রাউজার অডিও উচ্চারণ সমর্থন করছে না।");
        return;
      }
      window.speechSynthesis.cancel();
      document.querySelectorAll(".audio-btn.speaking").forEach(b => b.classList.remove("speaking"));

      const utter = new SpeechSynthesisUtterance(text);
      utter.lang = "de-DE";
      utter.rate = 0.92;

      const voices = window.speechSynthesis.getVoices();
      const deVoice = voices.find(v => v.lang && v.lang.toLowerCase().startsWith("de"));
      if (deVoice) utter.voice = deVoice;

      if (btnEl) {
        btnEl.classList.add("speaking");
        utter.onend = () => btnEl.classList.remove("speaking");
        utter.onerror = () => btnEl.classList.remove("speaking");
      }
      window.speechSynthesis.speak(utter);
    }

    if ("speechSynthesis" in window) {
      window.speechSynthesis.onvoiceschanged = () => window.speechSynthesis.getVoices();
    }

    function escapeAttr(str) {
      return String(str).replace(/\\/g, "\\\\").replace(/'/g, "\\'");
    }

    function getTheme(art) {
      if (art === "der") return { card: "theme-der", pill: "pill-der", txt: "txt-der", label: "der" };
      if (art === "die") return { card: "theme-die", pill: "pill-die", txt: "txt-die", label: "die" };
      if (art === "das") return { card: "theme-das", pill: "pill-das", txt: "txt-das", label: "das" };
      return { card: "theme-none", pill: "pill-none", txt: "txt-none", label: "ohne Artikel" };
    }

    function getFilteredList() {
      const q = document.getElementById("searchInput").value.trim().toLowerCase();
      const day = document.getElementById("dayFilter").value;
      const art = document.getElementById("artikelFilter").value;
      const status = document.getElementById("statusFilter").value;

      return vocabularyData
        .filter(item => {
          if (day !== "ALL" && item.day !== day) return false;
          if (art !== "ALL" && item.artikel !== art) return false;
          const isFav = state.fav.includes(item.id);
          const isLearned = state.learned.includes(item.id);
          if (status === "FAV" && !isFav) return false;
          if (status === "LEARNED" && !isLearned) return false;
          if (status === "UNLEARNED" && isLearned) return false;

          if (q) {
            const blob = `${item.artikel} ${item.german} ${item.plural} ${item.bangla} ${item.english} ${item.exDe} ${item.day}`.toLowerCase();
            if (!blob.includes(q)) return false;
          }
          return true;
        })
        .sort((a, b) => a.day.localeCompare(b.day) || a.serial - b.serial);
    }

    function toggleFav(id) {
      state.fav = state.fav.includes(id) ? state.fav.filter(x => x !== id) : [...state.fav, id];
      persist();
      render();
    }

    function toggleLearned(id) {
      state.learned = state.learned.includes(id) ? state.learned.filter(x => x !== id) : [...state.learned, id];
      persist();
      render();
    }

    function renderDictionary(list) {
      if (!list.length) {
        return `<div class="empty-state">কোনো শব্দ পাওয়া যায়নি। সার্চ বা ফিল্টার পরিবর্তন করে দেখুন।</div>`;
      }
      return `
        <div class="cards-grid">
          ${list.map(w => {
            const t = getTheme(w.artikel);
            const isFav = state.fav.includes(w.id);
            const isLearned = state.learned.includes(w.id);
            const displayWord = w.artikel ? `${w.artikel} ${w.german}` : w.german;

            return `
              <div class="word-card ${t.card}">
                <div>
                  <div class="card-header">
                    <span class="tag-pill">${w.day} • #${w.serial}</span>
                    <span class="art-pill ${t.pill}">${t.label}</span>
                  </div>

                  <div class="word-row">
                    <div>
                      <div class="german-title ${t.txt}">${displayWord}</div>
                      <div class="plural-line">Plural: <strong>${w.plural}</strong></div>
                    </div>
                    <button class="audio-btn" onclick="speakGerman('${escapeAttr(displayWord)}', this)" title="শব্দটি শুনুন">
                      🔊 শব্দ
                    </button>
                  </div>
                </div>

                <div class="meaning-block">
                  <div class="bn-text">${w.bangla}</div>
                  <div class="en-text">${w.english}</div>
                </div>

                <div class="example-card">
                  <div class="ex-top">
                    <div class="ex-de">${w.exDe}</div>
                    <button class="audio-btn" onclick="speakGerman('${escapeAttr(w.exDe)}', this)" title="উদাহরণ বাক্যটি শুনুন">
                      🔊 বাক্য
                    </button>
                  </div>
                  <div class="ex-bn">${w.exBn}</div>
                </div>

                <div class="card-footer">
                  <button class="status-btn ${isFav ? "fav-on" : ""}" onclick="toggleFav(${w.id})">
                    ${isFav ? "★ Favorite" : "☆ Favorite"}
                  </button>
                  <button class="status-btn ${isLearned ? "learn-on" : ""}" onclick="toggleLearned(${w.id})">
                    ${isLearned ? "✓ Learned" : "Mark Learned"}
                  </button>
                </div>
              </div>
            `;
          }).join("")}
        </div>
      `;
    }

    function renderFlashcards(list) {
      if (!list.length) {
        return `<div class="empty-state">ফ্ল্যাশকার্ডের জন্য কোনো শব্দ নেই।</div>`;
      }
      if (flashIdx >= list.length) flashIdx = 0;
      const w = list[flashIdx];
      const t = getTheme(w.artikel);
      const displayWord = w.artikel ? `${w.artikel} ${w.german}` : w.german;

      return `
        <div class="flash-container">
          <div class="flash-card ${t.card}" onclick="flashShowBack = !flashShowBack; render();">
            <div class="card-header" style="width:100%;">
              <span class="tag-pill">${w.day} • #${w.serial}</span>
              <span class="art-pill ${t.pill}">${t.label}</span>
            </div>

            <div class="flash-word ${t.txt}">${displayWord}</div>
            <div class="plural-line">Plural: <strong>${w.plural}</strong></div>

            <div style="margin-top:10px;" onclick="event.stopPropagation();">
              <button class="audio-btn" onclick="speakGerman('${escapeAttr(displayWord)}', this)">🔊 উচ্চারণ শুনুন</button>
            </div>

            ${flashShowBack ? `
              <div class="flash-back">
                <div class="bn-text">${w.bangla}</div>
                <div class="en-text">${w.english}</div>
                <div class="example-card" style="margin-top:10px; text-align:left;" onclick="event.stopPropagation();">
                  <div class="ex-top">
                    <div class="ex-de">${w.exDe}</div>
                    <button class="audio-btn" onclick="speakGerman('${escapeAttr(w.exDe)}', this)">🔊 বাক্য</button>
                  </div>
                  <div class="ex-bn">${w.exBn}</div>
                </div>
              </div>
            ` : `<div class="en-text" style="margin-top:14px;">(অর্থ ও উদাহরণ দেখতে কার্ডে ক্লিক করুন)</div>`}
          </div>

          <div class="nav-btns">
            <button class="mode-btn" onclick="flashIdx = (flashIdx - 1 + ${list.length}) % ${list.length}; flashShowBack = false; render();">← আগেরটি</button>
            <button class="primary-btn" onclick="flashShowBack = !flashShowBack; render();">${flashShowBack ? "প্রশ্ন দেখুন" : "উত্তর দেখুন"}</button>
            <button class="mode-btn" onclick="flashIdx = (flashIdx + 1) % ${list.length}; flashShowBack = false; render();">পরেরটি →</button>
          </div>
          <div class="plural-line" style="margin-top:10px;">কার্ড ${flashIdx + 1} / ${list.length}</div>
        </div>
      `;
    }

    function createQuiz(list) {
      if (list.length < 4) return;
      quizLocked = false;
      quizChosen = null;
      const target = list[Math.floor(Math.random() * list.length)];
      const others = list.filter(x => x.id !== target.id).sort(() => Math.random() - 0.5).slice(0, 3);
      const options = [...others, target].sort(() => Math.random() - 0.5);
      quizData = { target, options };
    }

    function answerQuiz(id) {
      if (quizLocked) return;
      quizLocked = true;
      quizChosen = id;
      render();
    }

    function renderQuiz(list) {
      if (list.length < 4) {
        return `<div class="empty-state">কুইজ খেলার জন্য কমপক্ষে ৪টি শব্দ থাকতে হবে।</div>`;
      }
      if (!quizData || !list.some(x => x.id === quizData.target.id)) {
        createQuiz(list);
      }
      const { target, options } = quizData;
      const t = getTheme(target.artikel);
      const displayWord = target.artikel ? `${target.artikel} ${target.german}` : target.german;

      return `
        <div class="quiz-box">
          <div class="card-header">
            <span class="tag-pill">${target.day} • #${target.serial}</span>
            <span class="art-pill ${t.pill}">${t.label}</span>
          </div>

          <div class="word-row" style="margin-top:12px;">
            <div class="german-title ${t.txt}">"${displayWord}" এর অর্থ কী?</div>
            <button class="audio-btn" onclick="speakGerman('${escapeAttr(displayWord)}', this)">🔊 শুনুন</button>
          </div>

          <div class="quiz-opts">
            ${options.map(opt => {
              let cls = "quiz-opt";
              if (quizLocked) {
                if (opt.id === target.id) cls += " correct";
                else if (quizChosen === opt.id) cls += " wrong";
              }
              return `
                <button class="${cls}" onclick="answerQuiz(${opt.id})">
                  ${opt.bangla} <span style="color:#64748b;">(${opt.english})</span>
                </button>
              `;
            }).join("")}
          </div>

          ${quizLocked ? `
            <div style="margin-top:14px; text-align:right;">
              <button class="primary-btn" onclick="createQuiz(getFilteredList()); render();">পরবর্তী প্রশ্ন →</button>
            </div>
          ` : ""}
        </div>
      `;
    }

    function render() {
      const list = getFilteredList();
      document.getElementById("stTotal").textContent = vocabularyData.length;
      document.getElementById("stShown").textContent = list.length;
      document.getElementById("stLearned").textContent = state.learned.length;
      document.getElementById("stFav").textContent = state.fav.length;

      const container = document.getElementById("appContent");
      if (activeMode === "dictionary") container.innerHTML = renderDictionary(list);
      else if (activeMode === "flashcard") container.innerHTML = renderFlashcards(list);
      else if (activeMode === "quiz") container.innerHTML = renderQuiz(list);
    }

    document.querySelectorAll(".mode-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".mode-btn").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        activeMode = btn.dataset.mode;
        flashShowBack = false;
        createQuiz(getFilteredList());
        render();
      });
    });

    ["searchInput", "dayFilter", "artikelFilter", "statusFilter"].forEach(id => {
      const el = document.getElementById(id);
      el.addEventListener("input", () => {
        flashIdx = 0;
        flashShowBack = false;
        createQuiz(getFilteredList());
        render();
      });
      el.addEventListener("change", () => {
        flashIdx = 0;
        flashShowBack = false;
        createQuiz(getFilteredList());
        render();
      });
    });

    createQuiz(vocabularyData);
    render();
  </script>
</body>
</html>
